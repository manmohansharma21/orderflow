digraph OrderFlowAWS {
 graph [rankdir=TB, bgcolor="white", pad="0.18", nodesep="0.28", ranksep="0.40", splines=polyline,
        fontname="Arial", fontsize=18, labelloc="t", label="PROPOSED AWS TARGET ARCHITECTURE — NOT DEPLOYED"];
 node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, margin="0.13,0.08", color="#4976A8", fillcolor="#EEF5FF", fontcolor="#16324F"];
 edge [fontname="Arial", fontsize=8, color="#50657D", fontcolor="#34495E", arrowsize=0.7];
 client [label="Clients / Postman"];
 ingress [label="Route 53 + HTTPS / ALB\nOptional if public DNS is required", fillcolor="#F4F0FF", color="#8567B5"];
 app [label="EC2 or managed container\nOrderFlow Go modular monolith"];
 rds [shape=cylinder, label="Private RDS PostgreSQL\nsource of truth", fillcolor="#EAF7EF", color="#3C8D63"];
 cache [shape=cylinder, label="Private ElastiCache\noptional product cache", fillcolor="#FFF4E5", color="#C8852B"];
 secrets [label="Secrets Manager / IAM role\nNo secrets in image or Git"];
 monitor [label="CloudWatch logs, metrics, alarms\nHTTP percentiles require app telemetry"];
 client -> ingress -> app;
 app -> rds [label="5432; app SG only"];
 app -> cache [label="6379; app SG only"];
 secrets -> app [style=dashed];
 app -> monitor [style=dashed];
}
