digraph OrderFlowClasses {
 graph [rankdir=TB, bgcolor="white", pad="0.18", nodesep="0.28", ranksep="0.40", splines=polyline,
        fontname="Arial", fontsize=18, labelloc="t", label="ORDERFLOW — DOMAIN CLASS / RELATIONSHIP VIEW"];
 node [shape=record, style="filled", fontname="Arial", fontsize=10, margin="0.08,0.06",
       color="#4976A8", fillcolor="#EEF5FF", fontcolor="#16324F", penwidth=1.1];
 edge [fontname="Arial", fontsize=9, color="#50657D", fontcolor="#34495E", arrowsize=0.7];
 User [label="{User|id: UUID\lemail\lrole: CUSTOMER/ADMIN\l}"];
 Product [label="{Product|id: UUID\lsku\lpricePaise\lisActive\l}"];
 Inventory [label="{Inventory|productID\lonHand\lreserved\lavailable = onHand - reserved\l}", fillcolor="#EAF7EF", color="#3C8D63"];
 Order [label="{Order|id: UUID\luserID\lstatus\ltotalAmountPaise\lidempotencyKey/requestHash\l}", fillcolor="#FFF4D6", color="#C59A34"];
 OrderItem [label="{OrderItem|orderID\lproductID\lquantity\lunitPrice snapshot\llineTotal snapshot\l}"];
 Payment [label="{Payment|id: UUID\lorderID\lstatus, amount, currency\lidempotencyKey/eventID\lfailureReason\l}", fillcolor="#F4F0FF", color="#8567B5"];
 Movement [label="{InventoryMovement|productID\lmovementType + deltas\lresulting balances\lreason/reference/actor\l}"];
 Provider [label="{MockProviderTransaction|paymentID\lproviderPaymentID\lstatus, amount, currency\lfailureReason\l}", fillcolor="#FFF4E5", color="#C8852B"];
 User -> Order [label="1 : many"];
 Product -> Inventory [label="1 : 1"];
 Order -> OrderItem [label="1 : many"];
 Product -> OrderItem [label="1 : many"];
 Order -> Payment [label="1 : many attempts"];
 Product -> Movement [label="1 : many"];
 Payment -> Provider [label="1 : 1 simulated record"];
}
