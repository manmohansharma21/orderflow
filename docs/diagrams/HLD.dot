digraph OrderFlowHLD {
 graph [rankdir=TB, bgcolor="white", pad="0.20", nodesep="0.24", ranksep="0.34", splines=polyline,
        fontname="Arial", fontsize=19, labelloc="t", label="ORDERFLOW — HIGH-LEVEL DESIGN (HLD)"];
 node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.16,0.10",
       color="#4976A8", fillcolor="#EEF5FF", fontcolor="#16324F", penwidth=1.25];
 edge [fontname="Arial", fontsize=9, color="#50657D", fontcolor="#34495E", arrowsize=0.72, penwidth=1.1];
 client [label="Customer / Admin / Postman\nHTTP + JSON", fillcolor="#E4EEFF"];
 api [label="Gin REST API\nRouter + request middleware\nJWT / roles / request ID"];
 handlers [label="HTTP handlers + request DTOs\nValidation + status/error mapping"];
 services [label="Application services\nCatalog · Orders · Inventory · Payments · Reporting\nBusiness rules + transactions", fillcolor="#EAF7EF", color="#3C8D63"];
 repos [label="Repository layer\npgx / parameterized SQL / row locks"];
 db [shape=cylinder, label="PostgreSQL — durable source of truth\nUsers · Products · Inventory · Orders / Items\nPayments · Inventory movements · Mock-provider ledger", fillcolor="#EAF7EF", color="#3C8D63"];
 redis [shape=cylinder, label="Optional Redis\nProduct-list/detail cache\nTTL + generation invalidation\nDisabled by default for measured workload", fillcolor="#FFF4E5", color="#C8852B"];
 expiry [label="Unpaid-order expiry worker\nRelease only eligible unpaid orders", fillcolor="#FFF4E5", color="#C8852B"];
 recovery [label="Mock-provider recovery worker\nRecover known terminal results after missed callback", fillcolor="#FFF4E5", color="#C8852B"];
 metrics [label="Observability\nX-Request-ID · request logs · /metrics", fillcolor="#F4F0FF", color="#8567B5"];
 ci [label="GitHub Actions CI\nMigrations · tests · race · vet\nDocker build + runtime smoke", fillcolor="#F4F0FF", color="#8567B5"];
 client -> api -> handlers -> services -> repos -> db;
 services -> redis [style=dashed, label="product reads only", color="#C8852B", constraint=false];
 expiry -> services [label="expire eligible orders", color="#C8852B", constraint=false];
 recovery -> services [label="apply known mock outcome", color="#C8852B", constraint=false];
 api -> metrics [style=dashed, label="record requests", color="#8567B5", constraint=false];
 ci -> api [style=dashed, label="validates exact commit", color="#8567B5", constraint=false];
 {rank=same; expiry; recovery; services; redis;}
}
