APP_ENV=development
PORT=8080
READINESS_TIMEOUT_SECONDS=3

# Local PostgreSQL connection (Docker Compose exposes port 5433).
# Replace CHANGE_ME with your local database password.
DATABASE_URL=postgres://orderflow:CHANGE_ME@localhost:5433/orderflow?sslmode=disable

# Authentication and mock callback signing secrets. Generate each independently.
# openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
MOCK_PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_A_DIFFERENT_64_HEX_CHAR_SECRET

# Redis is optional at runtime. If unavailable on startup, API remains available
# and product reads bypass the cache. The default local Compose Redis is below.
REDIS_ENABLED=true
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
PRODUCT_CACHE_TTL_SECONDS=60

# Read-only reconciliation reporter. Set interval to 0 to disable it.
RECONCILIATION_INTERVAL_SECONDS=300
RECONCILIATION_OLDER_THAN_MINUTES=15

# Expire old PENDING orders with no unresolved/successful payment; set interval to 0 to disable.
ORDER_EXPIRY_INTERVAL_SECONDS=300
ORDER_EXPIRY_AFTER_MINUTES=60
ORDER_EXPIRY_BATCH_SIZE=100
