APP_ENV=development
PORT=8080
READINESS_TIMEOUT_SECONDS=3

# Local PostgreSQL connection (Docker Compose exposes port 5433).
# Replace CHANGE_ME with your local database password.
DATABASE_URL=postgres://orderflow:CHANGE_ME@localhost:5433/orderflow?sslmode=disable

# Required for login/JWT. Generate using: openssl rand -hex 32
# Keep the generated value in local .env only; do not commit it.
JWT_SECRET=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET

# Required for the simulated payment callback, separate from JWT_SECRET.
# Generate an independent value using: openssl rand -hex 32
MOCK_PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_DIFFERENT_64_HEX_CHAR_RANDOM_SECRET
